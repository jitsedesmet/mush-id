#!/bin/sh
# Refuse the commit if the site no longer builds.
# Enable with: git config core.hooksPath .githooks
# Skip once with: git commit --no-verify
#
# Note: this builds the working tree, so unstaged changes are included.

if [ ! -d node_modules ]; then
    echo "pre-commit: node_modules missing, running npm ci..." >&2
    npm ci || exit 1
fi

if ! npm run --silent validate:key; then
    echo "pre-commit: commit aborted. Fix the key data or use --no-verify." >&2
    exit 1
fi

if ! npm run --silent build >/dev/null 2>&1; then
    echo "pre-commit: build failed, re-running to show output:" >&2
    npm run build >&2
    echo "pre-commit: commit aborted. Fix the build or use --no-verify." >&2
    exit 1
fi
